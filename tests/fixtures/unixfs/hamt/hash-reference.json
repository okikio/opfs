  "wrapper": "#include \"MurmurHash3.h\"\n#include <stdint.h>\nextern \"C\" void hamt_hash(const void *bytes, int length, uint8_t *output) {\n  uint64_t words[2];\n  MurmurHash3_x64_128(bytes, length, 0, words);\n  for (int i = 0; i < 8; i++) output[i] = uint8_t(words[0] >> (56 - i * 8));\n}\n",
