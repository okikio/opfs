"""Candidate-free native 2D Shapefile component producer and full-value consumer."""
import base64, hashlib, io, json, pathlib, struct, sys
wheel=pathlib.Path(sys.argv[1]);assert hashlib.sha256(wheel.read_bytes()).hexdigest()=='be8cd9436dcbde477c63ea789f7dcdea3af19f17ea84f2744bfc12efe9145d1e'
sys.path.insert(0,str(wheel));import shapefile
assert shapefile.__version__=='3.1.6'
rows=[['e\u0301\ufeffnative',9007199254740993,True],['second',-123,False],['null row',0,None]]
shapes={
 'point':(1,[{'xy':[[-0.0,3.25]],'parts':[]},{'xy':[[-7.5,-2]],'parts':[]},{'xy':[],'parts':[]}]),
 'polyline':(3,[{'xy':[[0,0],[2,2],[3,-1],[4,0],[5,1]],'parts':[0,2]},{'xy':[[-5,1],[-2,2]],'parts':[0]},{'xy':[],'parts':[]}]),
 'polygon':(5,[{'xy':[[0,0],[0,10],[10,10],[10,0],[0,0],[2,2],[8,2],[8,8],[2,8],[2,2]],'parts':[0,5]},{'xy':[[-5,0],[-4,1],[-3,0],[-5,0]],'parts':[0]},{'xy':[],'parts':[]}]),
 'multipoint':(8,[{'xy':[[1,2],[-3,4],[5,-6]],'parts':[]},{'xy':[[0,0]],'parts':[]},{'xy':[],'parts':[]}]),
 'empty':(1,[])
}
out=[]
for name,(typ,originals) in shapes.items():
    shp,shx,dbf=io.BytesIO(),io.BytesIO(),io.BytesIO()
    w=shapefile.Writer(shp=shp,shx=shx,dbf=dbf,shapeType=typ,encoding='utf-8',strict=True)
    w.field('label','C',40);w.field('exact','N',24,0);w.field('flag','L',1)
    for i,shape in enumerate(originals):
        points=shape['xy'];parts=shape['parts']
        if not points:w.null()
        elif typ==1:w.point(*points[0])
        elif typ==8:w.multipoint(points)
        else:
            rings=[points[p:(parts[j+1] if j+1<len(parts) else len(points))] for j,p in enumerate(parts)]
            if typ==3:w.line(rings)
            else:w.poly(rings)
        w.record(*rows[i])
    w.close();components={'shp':shp.getvalue(),'shx':shx.getvalue(),'dbf':dbf.getvalue()}
    reader=shapefile.Reader(shp=io.BytesIO(components['shp']),shx=io.BytesIO(components['shx']),dbf=io.BytesIO(components['dbf']),encoding='utf-8')
    nativeShapes=reader.shapes();nativeRows=reader.records();assert len(nativeShapes)==len(originals) and len(nativeRows)==len(originals)
    for i,shape in enumerate(originals):
        assert [list(p) for p in nativeShapes[i].points]==shape['xy'],(name,i,'points')
        assert list(nativeShapes[i].parts)==shape['parts'],(name,i,'parts')
        assert list(nativeRows[i])==rows[i],(name,i,'attributes',nativeRows[i],rows[i])
    geometry=components['shp'];index=components['shx'];attributes=components['dbf'];at=100;tuples=[]
    while at<len(geometry):
        record,length=struct.unpack_from('>ii',geometry,at);length*=2
        indexOffset,indexLength=struct.unpack_from('>ii',index,100+8*len(tuples))
        assert indexOffset*2==at and indexLength*2==length and record==len(tuples)+1
        tuples.append({'recordNumber':record,'offset':at+8,'bytes':length,'bodyBase64':base64.b64encode(geometry[at+8:at+8+length]).decode()});at+=8+length
    assert at==len(geometry) and len(tuples)==len(originals)
    count,headerLength,rowLength=struct.unpack_from('<IHH',attributes,4)
    assert count==len(originals);rawRows=[]
    for i in range(count):
        row=attributes[headerLength+i*rowLength:headerLength+(i+1)*rowLength]
        assert row[0]==0x20
        assert row[1:41]==rows[i][0].encode('utf-8').ljust(40,b' ')
        assert row[41:65]==str(rows[i][1]).encode('ascii').rjust(24,b' ')
        assert row[65:66]==(b'T' if rows[i][2] is True else b'F' if rows[i][2] is False else b' ')
        rawRows.append(base64.b64encode(row).decode())
    deleted=None
    if originals:
        edited=bytearray(attributes);edited[headerLength+rowLength]=0x2a
        consumer=shapefile.Reader(shp=io.BytesIO(geometry),shx=io.BytesIO(index),dbf=io.BytesIO(edited),encoding='utf-8')
        remaining=list(consumer.iterRecords())
        assert len(remaining)==len(originals)-1 and [r.oid for r in remaining]==[i for i in range(len(originals)) if i!=1]
        deleted={'adaptation':'one authored deletion flag change in genuine DBF; native consumer skips that ordinal','data':base64.b64encode(edited).decode(),'sha256':hashlib.sha256(edited).hexdigest(),'nativeVisibleOrdinals':[r.oid for r in remaining]}
    out.append({'name':name,'shapeType':typ,'originals':originals,'attributes':[{'label':r[0],'integer':str(r[1]),'flag':r[2]} for r in rows[:len(originals)]],'tuples':tuples,'rawRows':rawRows,'dbfHeaderLength':headerLength,'dbfRowLength':rowLength,'dbfTrailingBytes':len(attributes)-headerLength-count*rowLength,'components':{k:{'data':base64.b64encode(v).decode(),'bytes':len(v),'sha256':hashlib.sha256(v).hexdigest()} for k,v in components.items()},'authoredDeletion':deleted,'nativeAllGeometryAndAttributes':True,'independentRawRowsAndIndex':True})
pathlib.Path(sys.argv[2]).write_text(json.dumps({'producer':'pyshp3.1.6','python':sys.version,'wheelSha256':hashlib.sha256(wheel.read_bytes()).hexdigest(),'fixtures':out},indent=2)+'\n')
