# Pinned upstream snapshots must keep their original bytes on every platform.
tests/upstream/original/** -text -whitespace
.mise/tasks/attest.sh text eol=lf

# Historical research inputs retain their original bytes, including CSV CRLF.
planning/storage/research/** -text -whitespace

# Fixtures are byte-exact evidence: tests and provenance records pin their SHA-256, including text-looking JSON,
# licenses, receipts and Git objects. Without this, Git for Windows rewrites LF to CRLF on checkout and every pinned
# hash changes. `-text` only stops line-ending conversion; diffs still render as text.
tests/fixtures/** -text

# Frozen Glacier licenses retain their upstream whitespace.
tests/fixtures/glacier/legal/tslib-CopyrightNotice.txt -whitespace
tests/fixtures/glacier/legal/tslib-LICENSE.txt -whitespace
