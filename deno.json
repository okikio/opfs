  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": true,
    "singleQuote": false,
    "useTabs": false,
    "indentWidth": 2,
    "include": [
      "mod.ts",
      "src/",
      "tests/",
      "bench/",
      "docs/",
      "README.md",
      "AGENTS.md",
      "deno.json",
      "package.json",
      "tools/"
    ],
    "exclude": [
      "tests/upstream/original/",
      "tests/fixtures/age/upstream/",
      "tests/fixtures/age/provenance/**/*.json",
      "tests/fixtures/age/provenance/**/*.snapshot",
      "tests/fixtures/age/independent.json",
      "tests/fixtures/age/cctv.json",
      "tests/fixtures/orc/independent.json",
      "tests/fixtures/orc/receipts/",
      "tests/fixtures/ipc/native/",
      "tests/fixtures/bam/native/",
      "tests/fixtures/amqp/receipts/",
      "tests/fixtures/amqp/independent.json",
      "tests/fixtures/glacier/**/*.json",
      "tests/fixtures/glacier/**/*.snapshot",
      "tests/fixtures/kafka/native-client/",
      "tests/fixtures/age/provenance/**/*.mjs"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await"
      ]
    },
    "include": [
      "mod.ts",
      "src/",
      "tests/",
      "bench/",
      "tools/"
    ],
    "exclude": [
      "tests/upstream/original/",
      "tests/fixtures/age/upstream/",
      "tests/fixtures/age/provenance/**/*.json",
      "tests/fixtures/age/provenance/**/*.snapshot",
      "tests/fixtures/glacier/**/*.json",
      "tests/fixtures/glacier/**/*.snapshot"
    ]
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "docs/",
      "deno.json"
    ]
  },
  "allowScripts": {
    "allow": [],
    "deny": [
      "npm:cpu-features@0.0.10",
      "npm:fsevents@2.3.2",
      "npm:fsevents@2.3.3",
      "npm:protobufjs@7.6.5",
      "npm:ssh2@1.17.0"
    ]
  }
