{
	"name": "@utils/csv",
	"version": "1.0.0",
	"publish": false,
	"exports": {
		".": "./mod.ts",
		"./dialect": "./dialect.ts",
		"./encoding": "./encoding.ts",
		"./headers": "./headers.ts",
		"./parse": "./parse.ts",
		"./stream": "./stream.ts",
		"./types": "./types.ts"
	},
	"imports": {
		"@std/csv": "jsr:@std/csv@^1.0.6",
		"@std/expect": "jsr:@std/expect@^1.0.20"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check mod.ts types.ts dialect.ts encoding.ts headers.ts parse.ts stream.ts parse_test.ts stream_test.ts parse_bench.ts && deno doc --lint mod.ts",
		"test": "deno test -P=test",
		"bench": "deno bench -P=bench"
	},
	"permissions": {
		"test": {
			"read": [
				"./fixtures"
			]
		},
		"bench": {
			"read": [
				"./fixtures"
			]
		}
	}
}
