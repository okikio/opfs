{
	"name": "@utils/env",
	"version": "1.0.0",
	"publish": false,
	"exports": {
		".": "./mod.ts",
		"./standard": "./standard.ts",
		"./valibot": "./valibot.ts",
		"./zod": "./zod.ts"
	},
	"imports": {
		"@standard-schema/spec": "npm:@standard-schema/spec@^1.1.0",
		"@std/expect": "jsr:@std/expect@^1.0.20",
		"fast-check": "npm:fast-check@^4.9.0",
		"mitata": "npm:mitata@^1.0.34",
		"valibot": "npm:valibot@^1.4.2",
		"zod": "npm:zod@^4.4.3"
	},
	"tasks": {
		"check": "deno fmt --check && deno lint && deno check mod.ts standard.ts valibot.ts zod.ts source_test.ts standard_test.ts valibot_test.ts zod_test.ts && deno doc --lint mod.ts standard.ts valibot.ts zod.ts",
		"test": "deno test -P=test",
		"bench": "deno bench"
	},
	"permissions": {
		"test": {
			"env": true
		}
	},
	"fmt": {
		"lineWidth": 120,
		"semiColons": false,
		"singleQuote": true,
		"useTabs": true,
		"indentWidth": 2
	}
}
