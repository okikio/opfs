{
	"nodeModulesDir": "manual",
	"workspace": ["packages/media/*", "utils/*"],
	"exports": {},
	"imports": {
		"@logtape/logtape": "jsr:@logtape/logtape@^2.3.0",
		"@okikio/observables": "jsr:@okikio/observables@1.4.0",
		"@okikio/undent": "jsr:@okikio/undent@0.3.3",
		"@std/async": "jsr:@std/async@^1.5.0",
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/expect": "npm:@jsr/std__expect@1.0.20",
		"@std/media-types": "jsr:@std/media-types@^1.1.0",
		"mediabunny": "npm:mediabunny@^1.53.0",
		"zod": "npm:zod@4.4.3"
	},
	"compilerOptions": {
		"lib": ["deno.window", "dom", "dom.iterable"],
		"types": ["npm:@types/node"],
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true
	},
	"tasks": {
		"check:media": "deno check packages/media/*/mod.ts packages/media/*/mod_test.ts",
		"test:media": "deno test packages/media/*/mod_test.ts"
	},
	"fmt": {
		"lineWidth": 120,
		"semiColons": true,
		"singleQuote": true,
		"useTabs": true,
		"indentWidth": 2
	},
	"lint": {
		"rules": {
			"tags": ["recommended"],
			"exclude": ["no-slow-types", "require-await"]
		}
	}
}
