# Installed dependencies and local package-manager caches.
node_modules/
.pnpm-store/
.aube-store/
.pnp.*

# Build, package, coverage, and task-owned evidence.
/build/
/dist/
/.release/
/.tmp/
/tmp/
# Version maintained guidance and local validation; other agent scratch stays local.
!/.agents/
/.agents/*
!/.agents/validation/
/.agents/validation/*
!/.agents/validation/run.ts
!/.agents/validation/snapshot.ts
!/.agents/validation/snapshot.test.ts
!/.agents/validation/README.md
!/.agents/validation/.npmignore
/.coverage/
/coverage/
/.test-results/
/test-results/
/playwright-report/
/*.tgz
/*.zip
/*.tar
/*.tar.*
*.tsbuildinfo
*.log
*.log.*

# npm's build-tool resolver is local output; deno.lock owns dependencies.
/scripts/deno.lock

# Local credentials and editors. Reproducible example configuration remains visible.
.env
.env.*
!.env.example
/.idea/
/.vscode/
*.swp
*.orig
*~

# Operating-system metadata.
.DS_Store
._*
Thumbs.db
Desktop.ini
.fuse_hidden*
.nfs*

# Complete connected guidance and project-owned adoption records.
!/.agents/START.md
!/.agents/GUIDANCE.md
!/.agents/LICENSE
!/.agents/guides/
!/.agents/references/
!/.agents/skills/
!/.agents/handbook/
!/.agents/README.md
!/.agents/source.json
