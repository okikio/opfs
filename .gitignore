# Installed dependencies and local package-manager caches.
node_modules/
.pnpm-store/
.aube-store/
.pnp.*

# Build, package, coverage, and task-owned evidence.
/build/
/dist/
/.release/
/.tmp/
/tmp/
/.agents/
/.coverage/
/coverage/
/.test-results/
/test-results/
/playwright-report/
/*.tgz
/*.zip
/*.tar
/*.tar.*
*.tsbuildinfo
*.log
*.log.*

# npm's build-tool resolver is local output; deno.lock owns dependencies.
/scripts/deno.lock

# Local credentials and editors. Reproducible example configuration remains visible.
.env
.env.*
!.env.example
/.idea/
/.vscode/
*.swp
*.orig
*~

# Operating-system metadata.
.DS_Store
._*
Thumbs.db
Desktop.ini
.fuse_hidden*
.nfs*
