#!/usr/bin/env bash
#MISE description="Run the complete Deno quality, stress, coverage, JSR, and npm build gates."
set -euo pipefail

deno ci
deno task schema:check
deno task check
deno task lint
deno task doc
deno task fmt:check
deno task test:stress
deno task test:coverage
deno publish --dry-run
RELEASE_VERSION=0.0.0-quality mise run npm
