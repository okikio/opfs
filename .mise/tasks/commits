#!/usr/bin/env bash
#MISE description="Validate Conventional Commit messages for the selected Git range."
set -euo pipefail

: "${HEAD_SHA:?HEAD_SHA is required}"
BASE_SHA="${BASE_SHA:-}"
if [[ -z "$BASE_SHA" || "$BASE_SHA" == '0000000000000000000000000000000000000000' ]]; then
  BASE_SHA="$(git rev-list --max-parents=0 "$HEAD_SHA")"
fi

npx --yes --package=@commitlint/cli@21.2.1 commitlint \
  --default-config \
  --from "$BASE_SHA" \
  --to "$HEAD_SHA" \
  --verbose
